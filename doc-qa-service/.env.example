# LLM Provider Configuration
# Supported providers: 'ollama' (default/local), 'gemini', 'openai', 'anthropic'
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b

# Ollama Configuration (Local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Cloud LLM API Keys (Optional - only required if LLM_PROVIDER is set accordingly)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_DB_PATH=./chroma_db

# Document Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5

# Server
PORT=8100
HOST=0.0.0.0
