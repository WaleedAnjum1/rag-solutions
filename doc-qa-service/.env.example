# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_DB_PATH=./chroma_db

# Document Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5

# Server
PORT=8100
HOST=0.0.0.0
