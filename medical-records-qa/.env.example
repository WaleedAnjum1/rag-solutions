# Medical Records Q&A — Environment Variables
# Copy to .env and fill in values

# LLM Provider Configuration
# Supported providers: 'ollama' (default/local), 'gemini', 'openai', 'anthropic'
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Cloud LLM API Keys (Optional - only required if LLM_PROVIDER is set accordingly)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent storage path
CHROMA_DB_PATH=./chroma_db

# Chunking  (smaller = more precise retrieval for medical data)
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# Retrieval
TOP_K=6

# Server
HOST=0.0.0.0
PORT=8200
