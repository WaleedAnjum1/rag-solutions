# Medical Records Q&A — Environment Variables
# Copy to .env and fill in values

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embeddings (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent storage path
CHROMA_DB_PATH=./chroma_db

# Chunking  (smaller = more precise retrieval for medical data)
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# Retrieval
TOP_K=6

# Server
HOST=0.0.0.0
PORT=8200
