# Multi-Language Customer Support Bot — Environment Variables
# Copy to .env and fill in values

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embeddings (sentence-transformers model name)
# MUST be a multilingual model — a monolingual one cannot match a Spanish
# question to an English help article.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB persistent storage path
CHROMA_DB_PATH=./chroma_db

# Chunking  (support articles are short and self-contained; one answer per chunk)
CHUNK_SIZE=700
CHUNK_OVERLAP=140

# Retrieval
TOP_K=6

# Generation
NUM_CTX=8192
NUM_PREDICT=512
MAX_DOC_CHUNKS=20

# Languages
# 'auto' mirrors the customer's language; a code (e.g. 'en') forces every reply.
DEFAULT_ANSWER_LANGUAGE=auto
# Used when detection finds no usable signal.
FALLBACK_LANGUAGE=en

# Escalation
# Best-match relevance below this flags the reply for a human agent (0-1).
ESCALATION_MIN_RELEVANCE=0.45

# Server
HOST=0.0.0.0
PORT=8500
