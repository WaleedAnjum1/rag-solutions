# HR Policy & Onboarding Bot — Environment Variables
# Copy to .env and fill in values

# LLM Provider Configuration
# Supported providers: 'ollama' (default/local), 'gemini', 'openai', 'anthropic'
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Cloud LLM API Keys (Optional - only required if LLM_PROVIDER is set accordingly)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent storage path
CHROMA_DB_PATH=./chroma_db

# Chunking (HR policy docs and handbook sections can be longer than FAQs)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5

# Generation
NUM_CTX=8192
NUM_PREDICT=512
MAX_DOC_CHUNKS=20

# Escalation
# Best-match relevance below this flags the reply for a human HR rep (0-1).
ESCALATION_MIN_RELEVANCE=0.45

# Server
HOST=0.0.0.0
PORT=8400
